@using Company.G01.BLL.Interfaces
@model CreateEmployeeDTO
@inject IDepartmentRepository _departmentRepo

@{
    await _departmentRepo.GetAllAsync();
    // var Departments = new SelectList(ViewData["departments"] as IEnumerable<Department>,"Id" , "Name");
    var departments = new SelectList(await _departmentRepo.GetAllAsync(), "Id", "Name");
}

<div class="my-3">
    <label asp-for="Name" class="col-form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="Age" class="col-form-label"></label>
    <input asp-for="Age" class="form-control" />
    <span asp-validation-for="Age" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="Email" class="col-form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="Address" class="col-form-label"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="Phone" class="col-form-label"></label>
    <input asp-for="Phone" class="form-control" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="IsActive" class="col-form-check"></label>
    <input asp-for="IsActive" class="form-control" />

</div>

<div class="my-3">
    <label asp-for="IsDeleted" class="col-form-check"></label>
    <input asp-for="IsDeleted" class="form-control" />

</div>

<div class="my-3">
    <label asp-for="HiringDate" class="col-form-label"></label>
    <input asp-for="HiringDate" class="form-control" />
    <span asp-validation-for="HiringDate" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="CreateAt" class="col-form-label"></label>
    <input asp-for="CreateAt" class="form-control" />
    <span asp-validation-for="CreateAt" class="text-danger"></span>
</div>

<div class="my-3">
    <label asp-for="DepartmentId" class="col-form-label"></label>
    <select asp-for="DepartmentId" asp-items="departments" class="form-control">
       <option value="@null">-- Select Department --</option>
    </select>
</div>

<div class="my-3">
    <label asp-for="Image" class="col-form-label"></label>
    <input asp-for="Image" type="file" class="form-control" />
</div>